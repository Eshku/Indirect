{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@client/*": ["app/client/*"],
      "@managers/*": ["app/client/Managers/*"],
      "@ecs/*": ["app/client/ECS/*"],
      "@systems/*": ["app/client/Systems/*"],
      "@components/*": ["app/client/Components/*"],
      "@core/*": ["app/client/Core/*"],
      "@ui/*": ["app/client/UI/*"],
      "@assets/*": ["app/assets/*"],
      "@icons/*": ["app/assets/icons/*"],
      "@indirect/*": ["app/client/Indirect/*"]
    }
  },
  "exclude": ["node_modules"]
}
